# Copy to .env (server mode / local runs). In CI, pass these as environment variables instead.
# Never commit .env. None of these ever reach PR code: the sandbox gets no environment at all.

# --- Models: any OpenAI-compatible server (llama.cpp, Ollama, vLLM, LM Studio) ---------
# llama.cpp:  llama-server -m Llama-3.1-8B-Instruct-Q4_K_M.gguf --port 8100 -c 16384 -np 2 --jinja
# Ollama:     http://<host>:11434/v1   (one server can serve both models below)
LLM_BASE_URL=http://127.0.0.1:8100/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b
# Independent checker, ideally another model family. Empty CHECKER_BASE_URL = same server as above.
# A second llama-server instance for Gemma, e.g. on port 8101:
CHECKER_BASE_URL=http://127.0.0.1:8101/v1
CHECKER_API_KEY=
CHECKER_MODEL=gemma-4-12b
# Per-request context PRGuard may use. llama.cpp: --ctx-size divided by --parallel.
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=1500
# Requests in flight at once from PRGuard (protect a shared GPU).
LLM_CONCURRENCY=2
LLM_TIMEOUT_S=180
LLM_JSON_MODE=1
# Let reviewers call read-only GitHub tools mid-review (needs llama.cpp --jinja). Off is better for 8B models.
LLM_TOOLS=0
LLM_CACHE=0

# --- GitHub ------------------------------------------------------------------------------
UPSTREAM=github
# A PAT or GitHub App installation token with: contents:read, pull-requests:write, issues:write, actions:read
GITHUB_TOKEN=
# GitHub Enterprise Server: https://ghe.example.com/api/v3 and https://ghe.example.com
GITHUB_API_URL=https://api.github.com
GITHUB_SERVER_URL=https://github.com
# Only needed when the token cannot call /user (GitHub App tokens): the login PRGuard posts as.
GITHUB_BOT_LOGIN=github-actions[bot]

# --- Server mode (prguard serve) --------------------------------------------------------------
# Webhook secret configured on the GitHub App / repo webhook (events: Pull requests, Issue comments).
GITHUB_WEBHOOK_SECRET=
# Repos the webhook may act on, comma-separated, or * for any repo the token can reach.
PRGUARD_ALLOWED_REPOS=your-org/your-repo
# Protects the dashboard and /run /approve. Always set it if the port is reachable by others.
PRGUARD_API_TOKEN=
# Run PR linters/tests in the locked sandbox (needs the Docker socket and the prguard-sandbox image).
PRGUARD_SANDBOX=1
SANDBOX_IMAGE=prguard-sandbox
SANDBOX_TIMEOUT_S=120

# Verdict NEEDS_HUMAN when overall confidence is below this.
HITL_THRESHOLD=0.7
# Per-agent timeout (seconds). An 8B model on a busy GPU can take a while.
NODE_TIMEOUT_S=300
